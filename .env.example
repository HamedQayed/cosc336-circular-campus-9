# Copy this file to .env and enter your key locally. Never commit .env.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
AI_MODEL=z-ai/glm-5.3-flash
# Alternative direct OpenAI provider: AI_PROVIDER=openai and an unprefixed model ID.
OPENAI_API_KEY=
# Optional for remote HTTPS deployment only
# COOKIE_SECURE=1
# SECRET_KEY=generate-a-long-random-value
